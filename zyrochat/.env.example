# ZyroChat Environment Configuration Template
# Copy to .env and fill in your actual credentials

# LLM Provider Configuration
VITE_OPENROUTER_API_KEY=
VITE_MODEL=openrouter/free

# Tools & APIs
VITE_WEATHER_API_KEY=
VITE_NEWS_API_KEY=

# Backend URL (Frontend configuration)
VITE_BACKEND_URL=http://localhost:5000

# AI Image Generation Provider
# Options: pollinations (unmetered real Flux.1 AI generation) | openai (DALL-E 3) | openrouter
IMAGE_PROVIDER=pollinations
IMAGE_PROVIDER_API_KEY=
OPENAI_API_KEY=
IMAGE_MODEL=flux
