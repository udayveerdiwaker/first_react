# ZyroChat Backend Environment Configuration Template
# Copy to backend/.env and fill in server-side credentials

PORT=5000

# LLM Chat Provider API Keys (Keep server-side)
OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_MODEL=openrouter/free

# Tools & APIs
VITE_WEATHER_API_KEY=your_weather_api_key_here
VITE_NEWS_API_KEY=your_news_api_key_here

# AI Image Generation Provider (Keep server-side)
# Options: pollinations (unmetered real Flux.1 AI generation) | openai (DALL-E 3) | openrouter
IMAGE_PROVIDER=pollinations
IMAGE_PROVIDER_API_KEY=
OPENAI_API_KEY=
IMAGE_MODEL=flux
