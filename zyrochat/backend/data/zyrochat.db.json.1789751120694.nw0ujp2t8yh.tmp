  "messages": [
    {
      "id": "mess-51ff1f40-d02e-4007-a4ae-512fd49d8702",
      "conversationId": "conv-e2cc973a-1678-47ac-a359-4b1dd440a9fe",
      "role": "user",
      "text": "wiki",
      "sources": [],
      "attachments": [],
      "index": 0,
