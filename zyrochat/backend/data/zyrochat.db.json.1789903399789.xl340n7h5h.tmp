    {
      "id": "msg-bot-1789827136498",
      "conversationId": "conv-1789826156948-ul43l",
      "role": "bot",
      "text": "Here is a complete standalone HTML design pack. Save it as `index.html` and open it in a browser.\n\n```html\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Lumina — Modern Design Pack</title>\n  <style>\n    :root {\n      --bg: #080b16;\n      --surface: #101628;\n      --surface-2: #171f36;\n      --text: #f6f8ff;\n      --muted: #9ca8c7;\n      --primary: #7c5cff;\n      --secondary: #00d9c0;\n      --warning: #ffb84d;\n      --danger: #ff5d7a;\n      --radius: 20px;\n      --shadow: 0 20px 60px rgba(0, 0, 0, 0.35);\n      --transition: 220ms ease;\n    }\n\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      color: var(--text);\n      background: var(--bg);\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.6;\n      overflow-x: hidden;\n    }\n    body.modal-open { overflow: hidden; }\n    a { color: inherit; text-decoration: none; }\n    button, input { font: inherit; }\n    button { cursor: pointer; }\n    img { display: block; max-width: 100%; }\n    ::selection { color: #fff; background: var(--primary); }\n\n    .container { width: min(1160px, calc(100% - 40px)); margin-inline: auto; }\n    .section { padding: 100px 0; }\n    .section-kicker {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 14px;\n      color: var(--secondary);\n      font-size: 0.82rem;\n      font-weight: 800;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n    }\n    .section-kicker::before { content: \"\"; width: 28px; height: 2px; background: currentColor; }\n    .section-title {\n      max-width: 720px;\n      margin: 0 0 18px;\n      font-size: clamp(2rem, 5vw, 4rem);\n      line-height: 1.08;\n      letter-spacing: -0.045em;\n    }\n    .section-copy { max-width: 620px; color: var(--muted); font-size: 1.05rem; }\n    .section-head { margin-bottom: 46px; }\n    .section-head.center { text-align: center; }\n    .section-head.center .section-copy { margin-inline: auto; }\n    .section-head.center .section-kicker::before { display: none; }\n\n    /* Navigation */\n    .navbar {\n      position: fixed;\n      inset: 0 0 auto;\n      z-index: 100;\n      border-bottom: 1px solid transparent;\n      transition: 250ms ease;\n    }\n    .navbar.scrolled {\n      padding: 12px 0;\n      border-color: rgba(255, 255, 255, 0.08);\n      background: rgba(8, 11, 22, 0.86);\n      backdrop-filter: blur(16px);\n    }\n    .nav-inner { height: 78px; display: flex; align-items: center; justify-content: space-between; }\n    .logo { display: flex; align-items: center; gap: 10px; font-size: 1.25rem; font-weight: 900; letter-spacing: -0.03em; }\n    .logo-mark {\n      width: 36px; height: 36px;\n      display: grid; place-items: center;\n      border-radius: 11px;\n      background: linear-gradient(135deg, var(--primary), var(--secondary));\n      box-shadow: 0 8px 24px rgba(124, 92, 255, 0.35);\n    }\n    .nav-links { display: flex; align-items: center; gap: 30px; }\n    .nav-links a { color: var(--muted); font-size: 0.92rem; font-weight: 650; transition: var(--transition); }\n    .nav-links a:hover { color: #fff; }\n    .nav-cta { padding: 10px 18px; border-radius: 999px; background: #fff; color: #090c16 !important; }\n    .menu-toggle {\n      display: none;\n      width: 44px; height: 44px;\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-radius: 12px;\n      background: var(--surface);\n      color: #fff;\n    }\n\n    /* Hero */\n    .hero {\n      position: relative;\n      min-height: 900px;\n      display: grid;\n      align-items: center;\n      padding: 150px 0 90px;\n      overflow: hidden;\n      background:\n        radial-gradient(circle at 15% 20%, rgba(124, 92, 255, 0.25), transparent 30%),\n        radial-gradient(circle at 85% 70%, rgba(0, 217, 192, 0.14), transparent 30%),\n        var(--bg);\n    }\n    .hero::before, .hero::after {\n      content: \"\";\n      position: absolute;\n      border-radius: 50%;\n      filter: blur(1px);\n      pointer-events: none;\n    }\n    .hero::before { width: 420px; height: 420px; left: -180px; top: 100px; border: 1px solid rgba(255,255,255,0.08); }\n    .hero::after { width: 280px; height: 280px; right: -100px; bottom: 70px; border: 1px dashed rgba(0,217,192,0.25); }\n    .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 70px; align-items: center; }\n    .hero-badge {\n      width: fit-content;\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      padding: 8px 13px;\n      border: 1px solid rgba(255,255,255,0.12);\n      border-radius: 999px;\n      color: #dfe5ff;\n      background: rgba(255,255,255,0.05);\n      font-size: 0.82rem;\n      font-weight: 700;\n      backdrop-filter: blur(10px);\n    }\n    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--secondary); box-shadow: 0 0 0 5px rgba(0,217,192,0.12); }\n    .hero h1 { max-width: 760px; margin: 24px 0; font-size: clamp(3.2rem, 7vw, 6.8rem); line-height: 0.96; letter-spacing: -0.07em; }\n    .gradient-text { color: transparent; background: linear-gradient(100deg, #a99aff, #fff 48%, var(--secondary)); background-clip: text; -webkit-background-clip: text; }\n    .hero p { max-width: 620px; color: var(--muted); font-size: 1.12rem; }\n    .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }\n    .btn {\n      min-height: 50px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      padding: 0 22px;\n      border: 0;\n      border-radius: 13px;\n      font-weight: 800;\n      transition: transform var(--transition), box-shadow var(--transition), background var(--transition);\n    }\n    .btn:hover { transform: translateY(-3px); }\n    .btn-primary { color: #fff; background: linear-gradient(135deg, var(--primary), #5b3df5); box-shadow: 0 14px 35px rgba(124,92,255,0.3); }\n    .btn-primary:hover { box-shadow: 0 18px 45px rgba(124,92,255,0.45); }\n    .btn-secondary { color: #fff; border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.06); }\n    .btn-secondary:hover { background: rgba(255,255,255,0.11); }\n    .btn-ghost { color: #081018; background: var(--secondary); }\n    .hero-visual { position: relative; min-height: 470px; }\n    .glass-panel {\n      position: absolute;\n      border: 1px solid rgba(255,255,255,0.12);\n      border-radius: 24px;\n      background: linear-gradient(145deg, rgba(255,255,255,0.13), rgba(255,255,255,0.04));\n      box-shadow: var(--shadow);\n      backdrop-filter: blur(18px);\n    }\n    .panel-main { inset: 45px 15px 55px 30px; padding: 28px; }\n    .panel-small { top: 5px; right: 0; width: 210px; padding: 20px; animation: float 5s ease-in-out infinite; }\n    .panel-bottom { right: 15px; bottom: 0; width: 260px; padding: 20px; animation: float 6s 0.8s ease-in-out infinite; }\n    .panel-label { color: var(--muted); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }\n    .panel-value { margin-top: 5px; font-size: 1.7rem; font-weight: 900; letter-spacing: -0.04em; }\n    .chart { height: 150px; display: flex; align-items: end; gap: 10px; margin-top: 25px; }\n    .chart span { flex: 1; height: var(--height); border-radius: 8px 8px 3px 3px; background: linear-gradient(180deg, var(--secondary), rgba(0,217,192,0.15)); }\n    .mini-row { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; }\n    .avatar-stack { display: flex; }\n    .avatar { width: 32px; height: 32px; display: grid; place-items: center; margin-left: -8px; border: 3px solid #111827; border-radius: 50%; color: #081018; font-size: 0.72rem; font-weight: 90",
