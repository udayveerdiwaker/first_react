    {
      "id": "msg-bot-1789826252615",
      "conversationId": "conv-1789826156948-ul43l",
      "role": "bot",
      "text": "Hello! I’m ZyroChat, your professional AI workspace assistant. I’m functioning normally and ready to support you with coding, research, writing, data analysis, or any other project you have. What would you like to work on?",
      "status": "completed",
      "generationId": "gen-1789826252615-l16jo0",
