    {
      "id": "msg-bot-1789902687981",
      "conversationId": "conv-1789826156948-ul43l",
      "role": "bot",
      "text": "Welcome to ZyroChat! I'm your professional AI workspace assistant. I can help with:\n\n- **Chat and research** - discussions, information gathering\n- **Writing and documents** - content creation, editing\n- **Coding** - development, debugging, architecture\n- **File and data analysis** - working with datasets, files\n- **Brainstorming** - ideation, planning\n\nHow can I assist you today?",
      "status": "completed",
      "generationId": "gen-1789902687981-h4wpxj",
      "requestId": null,
      "sources": [],
